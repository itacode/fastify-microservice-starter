{
  "name": "fastify-microservice-starter",
  "version": "1.0.0",
  "description": "Boilerplate to start developing a microservice with Fastify.",
  "main": "src/server.ts",
  "scripts": {
    "dev": "cross-env PLATFORM=development node --inspect --watch --watch-path=src --import tsx src/server.ts | pino-pretty",
    "start": "cross-env NODE_ENV=production PLATFORM=production node --enable-source-maps dist/server.js",
    "build": "node -e \"require('fs').rmSync('dist', {recursive:true, force:true})\" && tsc --incremental false",
    "test": "jest --coverage",
    "lint": "eslint .",
    "format": "prettier --write src/ tests/",
    "format:check": "prettier --check src/ tests/"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/autoload": "^6.5.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/sensible": "^6.0.4",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.0",
    "fastify-cli": "^8.0.0",
    "fastify-plugin": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "jest": "^30.4.2",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
